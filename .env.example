# ---- Agent IA (opencode) : fournissez AU MOINS une clé de modèle ----
# Clé Google AI Studio (recommandée — gratuite) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Alternatives payantes/autres fournisseurs :
# OPENROUTER_API_KEY=        # 1 clé pour tous les modèles
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# ---- GitHub : pousser le code modifié sur vos dépôts ----
GITHUB_TOKEN=
GIT_USER=
GIT_EMAIL=

# ---- Modèle de l'agent de chat (optionnel) ----
AGENT_MODEL=gemini-3.6-flash

# ---- Ports (optionnel) ----
PORT=8125
